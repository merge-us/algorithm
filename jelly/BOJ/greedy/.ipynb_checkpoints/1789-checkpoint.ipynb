    "s = int(input())\n",
    "\n",
    "sum_result = 0\n",
    "\n",
    "i = 1\n",
    "while True:\n",
    "    sum_result += i    \n",
    "\n",
    "    if sum_result > s:\n",
    "        break\n",
    "\n",
    "    i += 1\n",
    "    \n",
    "print(i - 1)"
