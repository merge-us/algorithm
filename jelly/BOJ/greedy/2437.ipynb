    "n = int(input())\n",
    "\n",
    "data = list(map(int, input().split()))\n",
    "data.sort()\n",
    "\n",
    "result = 0\n",
    "for i in data:\n",
    "    if i > result + 1:\n",
    "        break\n",
    "        \n",
    "    result += i\n",
    "print(result + 1)"
   ]
